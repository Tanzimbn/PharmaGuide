# Copy to .env and adjust. Never commit real .env.
DATABASE_URL=postgresql+psycopg://pharma:pharma@localhost:5432/pharmaguide

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

CHUNK_MAX_TOKENS=512
CHUNK_OVERLAP_TOKENS=64

MAX_PAGES_PER_FILE=150
MAX_FILE_MB=50

# --- LLM generation (OpenAI-compatible /chat/completions adapter) ---
# Any OpenAI-compatible host works — pick ONE block below. The MVP intent is a
# free-trial hosted endpoint with non-confidential sample PDFs only (NFR-2).
# Only LLM_API_KEY is required; base_url/model fall back to the Groq defaults.
LLM_PROVIDER=openai_compatible
LLM_API_KEY=

# Groq (default — free tier, fast)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter (free + paid models)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct

# Together
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# OpenAI (paid)
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# On-device / in-VPC for data residency (Ollama; no key needed)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2:3b

DEBUG=false
