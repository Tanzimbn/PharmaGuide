# Copy to `.env` (gitignored) and fill in. EXPO_PUBLIC_* vars are inlined into
# the app bundle at build time by Expo. DEV ONLY — a real key still ends up in
# your local build; M4 moves it to secure device storage. Never commit `.env`.

# Required for M2 query generation. Get a free trial key (e.g. https://console.groq.com).
EXPO_PUBLIC_LLM_API_KEY=

# Optional — override the OpenAI-compatible endpoint/model (defaults: Groq trial).
# EXPO_PUBLIC_LLM_BASE_URL=https://api.groq.com/openai/v1
# EXPO_PUBLIC_LLM_MODEL=llama-3.3-70b-versatile
