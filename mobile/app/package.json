{
  "name": "pharmaguide-mobile",
  "version": "0.0.0",
  "private": true,
  "description": "PharmaGuide Track B mobile app (on-device RAG). Graduated from the M0 spike; M1 = on-device ingestion (docs/mobile.md).",
