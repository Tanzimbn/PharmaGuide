    "expo-document-picker": "~13.0.3",
    "expo-file-system": "~18.0.4",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "onnxruntime-react-native": "1.20.0",
    "react": "18.3.1",
    "react-native": "0.76.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "~5.3.3"
  }
}
